# SQLite mặc định - phù hợp để chạy thử
DATABASE_URL=sqlite:///./pet_care.db

# Sample only. Generate a strong unique value, e.g. py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_UNIQUE_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI: mock = chạy không cần API key; gemini = dùng Gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ADMIN_EMAIL=admin@gmail.com
# Sample only. Replace with a strong unique password before running the application.
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_NAME=Quản trị viên
